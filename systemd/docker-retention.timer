[Unit]
Description=Daily Docker image and build-cache retention (space-server)

[Timer]
# 04:30 UTC: clear of the nightly jobs (00:00-01:00 and 20:25-20:45 UTC) and
# of deploys, which are human-triggered releases.
OnCalendar=*-*-* 04:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
