BUGSINK_SECRET_KEY=change-me-generate-with-openssl-rand-base64-48
BUGSINK_ADMIN_EMAIL=admin@example.com
# No ':' in this value — CREATE_SUPERUSER combines it with the email as
# email:password, and a colon in the password breaks that split.
BUGSINK_ADMIN_PASSWORD=change-me
BUGSINK_DB_PASSWORD=change-me
