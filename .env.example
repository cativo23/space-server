# Traefik / ACME
ACME_EMAIL=your-email@example.com
# Absolute path to acme.json on the host (used by mail-server to read TLS certs)
TRAEFIK_ACME_PATH=/home/your-user/space-server/traefik/letsencrypt/acme.json

# Grafana
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-to-a-strong-password

# Basic Auth (generate with: htpasswd -nB admin)
TRAEFIK_BASIC_AUTH_USERS=admin:$$apr1$$your-hash-here
