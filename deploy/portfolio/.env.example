# Portfolio (Nuxt) frontend
# Copy to .env and fill in values before deploying.

DOCKER_USERNAME=cativo23   # Docker Hub username for the image

NUXT_API_TOKEN=            # Token for portfolio-api
NUXT_API_BASE_URL=         # e.g. https://api.cativo.dev
NUXT_API_BASE_PATH=        # e.g. /api

POW_GH_TOKEN=              # GitHub personal access token (read:user, read:repo)

# Optional — Spotify now-playing widget
NUXT_SPOTIFY_CLIENT_ID=
NUXT_SPOTIFY_CLIENT_SECRET=
NUXT_SPOTIFY_REFRESH_TOKEN=
