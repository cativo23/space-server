# Portfolio API (NestJS) + MariaDB + Redis
# Copy to .env and fill in values before deploying.

DOCKER_USERNAME=cativo23   # Docker Hub username for the API image

# Database
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=portfolio
DB_PASSWORD=               # MariaDB user password
DB_NAME=portfolio
MYSQL_ROOT_PASSWORD=       # MariaDB root password (different from DB_PASSWORD)

# Auth / security
JWT_SECRET=                # 32+ char random string
JWT_EXPIRES_IN=7d
API_KEY_SECRET=            # 32+ char random string for API key hashing

# CORS
CORS_ORIGINS=https://cativo.dev,https://api.cativo.dev

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=            # Redis AUTH password
REDIS_TTL=3600

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_PUBLIC_LIMIT=20
THROTTLE_STRICT_LIMIT=5
