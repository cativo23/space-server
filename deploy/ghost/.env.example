# Ghost blog + MySQL
# Copy to .env and fill in values before deploying.

DB_PASSWORD=               # MySQL password for ghost user and root

# Outbound mail (SMTP relay, e.g. Resend or Mailgun)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=                 # Resend / SMTP API key
